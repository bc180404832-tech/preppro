# Google AI Studio (Gemini) API Key
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenRouter API Key
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Primary AI Provider ('gemini' or 'openrouter')
# If one is rate-limited (HTTP 429), PrepPro automatically falls back to the other!
PREPPRO_PRIMARY_PROVIDER=gemini
